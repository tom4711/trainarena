@page
@{
    ViewData["Title"] = "TrainArena Host";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TrainArena — Host</title>
    <link rel="stylesheet" href="/css/host.css" />
    <style>
      label { display: block; margin: 0.75rem 0; color: var(--muted); }
      select, input {
        display: block; width: 100%; margin-top: 0.35rem;
        padding: 0.6rem 0.7rem; border-radius: 8px; border: 1px solid #475569;
        background: #0f172a; color: var(--text);
      }
    </style>
</head>
<body>
    <main class="host">
        <h1>TrainArena</h1>
        <p class="tagline">Host · Ausbilder · <a href="/Editor">Quiz-Editor</a></p>

        <section id="setup" class="panel">
            <label>Quiz wählen
                <select id="quiz-select"></select>
            </label>
            <button id="btn-create" type="button">Raum erstellen</button>
            <p id="room-code" class="code hidden"></p>
            <p id="lobby-status" class="muted">Noch kein Raum.</p>
            <ul id="player-list"></ul>
            <button id="btn-start" type="button" class="hidden" disabled>Quiz starten</button>
            <p class="hint">Spieler öffnen <a id="player-link" href="/player/">/player/</a> und geben den Code ein.</p>
        </section>

        <section id="live" class="panel hidden">
            <p id="progress" class="muted"></p>
            <h2 id="question-text"></h2>
            <p id="timer" class="timer" aria-live="polite"></p>
            <ol id="options" class="options"></ol>
            <p id="reveal" class="reveal hidden"></p>
            <div id="board" class="board hidden">
                <h3>Rangliste</h3>
                <ol id="board-list"></ol>
                <p id="board-hint" class="muted hidden">Host entscheidet mit „Weiter“ — kein Auto-Advance.</p>
            </div>
            <button id="btn-next" type="button" class="hidden">Nächste Frage</button>
            <p id="finished" class="hidden">Runde beendet.</p>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="/js/host.js"></script>
</body>
</html>
