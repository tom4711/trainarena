@page
@{
    ViewData["Title"] = "TrainArena Host";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/assets/brand/favicon.png" type="image/png" />
    <title>TrainArena — Host</title>
    <link rel="stylesheet" href="/css/host.css" />
</head>
<body>
    <main class="host">
        <div class="brand-row">
            <img class="brand-mark" src="/assets/brand/logo-icon.png" width="64" height="64" alt="" />
            <h1>TrainArena</h1>
        </div>
        <p class="tagline">Host · Ausbilder · <a href="/Editor">Quiz-Editor</a></p>

        <section id="setup" class="panel">
            <label>Quiz wählen
                <select id="quiz-select" aria-label="Quiz wählen" disabled>
                    <option value="">Quiz werden geladen…</option>
                </select>
            </label>
            <fieldset id="powerup-setup" class="powerup-setup">
                <legend>Power-Ups</legend>
                <label class="inline">
                    <input type="checkbox" id="pu-enabled" checked />
                    Aktiviert
                </label>
                <label class="inline">
                    Streak alle
                    <input type="number" id="pu-streak" min="0" max="99" value="2" />
                    richtige
                </label>
                <div class="pu-starters">
                    <label>50/50 <input type="number" id="pu-fifty" min="0" max="9" value="1" /></label>
                    <label>Double <input type="number" id="pu-double" min="0" max="9" value="1" /></label>
                    <label>Extra-Zeit <input type="number" id="pu-extra" min="0" max="9" value="0" /></label>
                    <label>Shield <input type="number" id="pu-shield" min="0" max="9" value="1" /></label>
                    <label>Störimpuls <input type="number" id="pu-disrupt" min="0" max="9" value="1" /></label>
                </div>
            </fieldset>
            <fieldset id="auto-advance-setup" class="powerup-setup">
                <legend>Auto-Weiter</legend>
                <label class="inline">
                    <input type="checkbox" id="aa-enabled" />
                    Automatisch weiter
                </label>
                <label class="inline">
                    Verzögerung
                    <select id="aa-delay" aria-label="Verzögerung bis zur nächsten Frage">
                        <option value="3">3 Sekunden</option>
                        <option value="5" selected>5 Sekunden</option>
                        <option value="10">10 Sekunden</option>
                    </select>
                </label>
            </fieldset>
            <button id="btn-create" type="button" disabled>Raum erstellen</button>
            <p id="room-code" class="code hidden" aria-live="polite"></p>
            <div id="qr-wrap" class="hidden">
                <canvas id="qr-canvas" width="180" height="180" aria-label="QR-Code zum Beitreten"></canvas>
                <p id="join-url" class="hint"></p>
            </div>
            <p id="lobby-status" class="status is-loading" aria-live="polite">Verbinde…</p>
            <ul id="player-list" aria-label="Verbundene Spieler"></ul>
            <button id="btn-start" type="button" class="hidden" disabled>Quiz starten</button>
            <p class="hint">Tipp: Host-Seite über die LAN-IP öffnen (nicht localhost), damit Handys den QR-Link erreichen.</p>
        </section>

        <section id="live" class="panel hidden">
            <div class="live-meta">
                <p id="progress" class="muted"></p>
                <p id="timer" class="timer" aria-live="polite"></p>
            </div>
            <h2 id="question-text"></h2>
            <img id="question-image" class="q-image hidden" alt="" />
            <div id="arena-actions" class="button-row hidden" aria-label="Arena-Power-Ups">
                <button id="btn-boost" type="button">Team-Boost</button>
                <button id="btn-time-plus" type="button">Zeit +5</button>
            </div>
            <p id="arena-status" class="hidden" aria-live="polite"></p>
            <ol id="options" class="options"></ol>
            <p id="reveal" class="reveal hidden"></p>
            <div id="board" class="board hidden">
                <h3>Rangliste</h3>
                <ol id="board-list"></ol>
                <p id="board-hint" class="muted hidden">Du entscheidest mit „Weiter“ — kein automatischer Wechsel.</p>
                <p id="board-auto-advance" class="hint hidden" aria-live="polite"></p>
            </div>
            <button id="btn-next" type="button" class="hidden">Nächste Frage</button>
            <p id="finished" class="hidden">Runde beendet. Danke!</p>
        </section>

        <div id="fx-overlay" class="fx-overlay hidden" aria-live="assertive" aria-atomic="true">
            <div class="fx-burst" aria-hidden="true"></div>
            <p id="fx-title" class="fx-title"></p>
            <p id="fx-sub" class="fx-sub"></p>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
    <script src="/js/host.js"></script>
</body>
</html>
