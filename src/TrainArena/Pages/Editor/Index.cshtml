@page
@using TrainArena.Data
@model TrainArena.Pages.Editor.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Quiz-Editor";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/brand/favicon.png?v=20261008" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/brand/logo-icon.png?v=20261008" />
    <title>TrainArena — Editor</title>
    <link rel="stylesheet" href="/css/host.css" />
</head>
<body>
<main class="host editor">
    <div class="brand-row">
        <img class="brand-mark" src="/assets/brand/logo-icon.png?v=20261008" width="64" height="64" alt="TrainArena" />
        <h1>Quiz-Editor</h1>
    </div>
    <p class="tagline"><a href="/">← Host</a></p>

    <section class="panel">
        <h2>Neues Quiz</h2>
        <form method="post" asp-page-handler="Create">
            <label>Titel
                <input name="title" required maxlength="200" placeholder="z. B. Sicherheit Basics" />
            </label>
            <button type="submit">Anlegen</button>
        </form>
        <div asp-validation-summary="All" class="flash flash-error validation-banner"></div>
    </section>

    <section class="panel">
        <h2>Vorhandene Quizzes</h2>
        @if (Model.Quizzes.Count == 0)
        {
            <p class="muted editor-empty">Noch keine Quizzes.</p>
        }
        else
        {
            <ul class="quiz-list">
            @foreach (var quiz in Model.Quizzes)
            {
                var quizTags = quiz.Questions
                    .SelectMany(q => QuestionTags.Parse(q.Tags))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                <li class="quiz-row">
                    <div class="quiz-row-main">
                        <a class="quiz-row-title" asp-page="Edit" asp-route-id="@quiz.Id">@quiz.Title</a>
                        <span class="muted quiz-row-meta">@quiz.Questions.Count Fragen</span>
                        @if (quizTags.Count > 0)
                        {
                            <div class="tag-row">
                                @foreach (var tag in quizTags)
                                {
                                    <span class="tag-chip">@tag</span>
                                }
                            </div>
                        }
                    </div>
                    <form method="post" asp-page-handler="Delete" class="quiz-row-actions">
                        <input type="hidden" name="id" value="@quiz.Id" />
                        <button type="submit" class="danger" onclick="return confirm('Quiz löschen?');">Löschen</button>
                    </form>
                </li>
            }
            </ul>
        }
    </section>

    <p class="app-version" aria-label="App-Version">v@(AppVersion.Display)</p>
</main>
</body>
</html>
