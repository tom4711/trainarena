@page "{id:guid}"
@using TrainArena.Data
@using TrainArena.Data.Entities
@model TrainArena.Pages.Editor.EditModel
@{
    Layout = null;
    var quiz = Model.Quiz!;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/brand/favicon.png?v=20261008" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/brand/logo-icon.png?v=20261008" />
    <title>Quiz bearbeiten — @quiz.Title</title>
    <link rel="stylesheet" href="/css/host.css" />
    <link rel="stylesheet" href="/lib/prism/prism-tomorrow.min.css" />
</head>
<body>
<main class="host editor">
    <div class="brand-row">
        <img class="brand-mark" src="/assets/brand/logo-icon.png?v=20261008" width="64" height="64" alt="TrainArena" />
        <h1>Quiz bearbeiten</h1>
    </div>
    <p class="tagline"><a href="/Editor">← Alle Quizzes</a> · <a href="/">Host</a></p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="flash flash-error" role="alert">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <p class="flash flash-ok" role="status">@Model.InfoMessage</p>
    }

    <section class="panel">
        <form method="post" asp-page-handler="SaveTitle">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Titel
                <input name="title" value="@quiz.Title" required maxlength="200" />
            </label>
            <button type="submit">Titel speichern</button>
        </form>
    </section>

    <section class="panel">
        <h2>Import CSV / JSON</h2>
        <p class="muted">TrainArena-CSV, Kahoot-CSV oder JSON-Quiz-Pack. Ungültige Einträge werden übersprungen. JSON kann Fragetypen, Code-Fences und eingebettete Bilder (Base64) enthalten — siehe <code>docs/quizzes/</code>.</p>
        <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="import-zone">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Datei wählen
                <input type="file" name="file" accept=".csv,.json,text/csv,application/json" required />
            </label>
            <button type="submit">Importieren</button>
        </form>
    </section>

    <section class="panel">
        <h2>Fragen (@quiz.Questions.Count)</h2>
        @if (quiz.Questions.Count == 0)
        {
            <p class="muted editor-empty">Noch keine Fragen — Import nutzen oder unten anlegen.</p>
        }
        <div class="questions-grid">
        @foreach (var q in quiz.Questions.OrderBy(x => x.SortOrder))
        {
            var filled = QuizRules.GetFilledOptions(q);
            var isEditing = Model.EditingQuestionId == q.Id;
            var qTags = QuestionTags.Parse(q.Tags);
            var tagsDisplay = qTags.Count > 0 ? string.Join(", ", qTags) : "";
            <div class="q-card">
                @if (isEditing)
                {
                    <form method="post" asp-page-handler="UpdateQuestion" enctype="multipart/form-data" class="edit-question-form" data-edit-form>
                        <input type="hidden" name="id" value="@quiz.Id" />
                        <input type="hidden" name="questionId" value="@q.Id" />
                        <p class="muted">Frage @(q.SortOrder + 1) bearbeiten</p>
                        <label class="question-text-field">Fragetext
                            <div class="question-compose">
                                <textarea name="text" class="js-question-text-input" required rows="4">@q.Text</textarea>
                                <div class="question-preview-panel">
                                    <p class="question-preview-label muted">Vorschau (wie Teilnehmer)</p>
                                    <div class="q-text js-question-preview" aria-live="polite"></div>
                                </div>
                            </div>
                        </label>
                        <label>Fragetyp
                            <select name="displayKind" id="edit-displayKind-@q.Id">
                                @if (q.DisplayKind == QuestionDisplayKind.Mc)
                                {
                                    <option value="Mc" selected>Multiple Choice</option>
                                    <option value="TrueFalse">Wahr/Falsch</option>
                                }
                                else
                                {
                                    <option value="Mc">Multiple Choice</option>
                                    <option value="TrueFalse" selected>Wahr/Falsch</option>
                                }
                            </select>
                        </label>
                        @if (!string.IsNullOrEmpty(q.ImagePath))
                        {
                            <img class="q-thumb" src="@q.ImagePath" alt="" />
                            <label>
                                <input type="checkbox" name="removeImage" value="true" />
                                Bild entfernen
                            </label>
                        }
                        <label>Bild (optional, max. 2&nbsp;MB — JPEG/PNG/WebP/GIF)
                            <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
                        </label>
                        <div id="edit-mc-options-@q.Id" class="js-mc-options">
                            <label>Option A<input class="mc-option" name="option0" data-required-mc="true" required value="@q.Option0" /></label>
                            <label>Option B<input class="mc-option" name="option1" data-required-mc="true" required value="@q.Option1" /></label>
                            <label>Option C<input class="mc-option" name="option2" value="@q.Option2" /></label>
                            <label>Option D<input class="mc-option" name="option3" value="@q.Option3" /></label>
                            <label>Option E<input class="mc-option" name="option4" value="@q.Option4" /></label>
                            <label>Option F<input class="mc-option" name="option5" value="@q.Option5" /></label>
                            <label>Richtige Antwort
                                <select name="correctIndex" class="js-correct-select">
                                    @for (var ci = 0; ci < 6; ci++)
                                    {
                                        if (q.CorrectIndex == ci)
                                        {
                                            <option value="@ci" selected>@((char)('A' + ci))</option>
                                        }
                                        else
                                        {
                                            <option value="@ci">@((char)('A' + ci))</option>
                                        }
                                    }
                                </select>
                            </label>
                        </div>
                        <div id="edit-tf-options-@q.Id" class="js-tf-options" hidden>
                            <p class="muted">Antworten: Wahr und Falsch (fest)</p>
                            <div class="tf-row">
                                @if (q.CorrectIndex == 0)
                                {
                                    <label><input type="radio" name="correctIndex" value="0" checked /> Wahr</label>
                                    <label><input type="radio" name="correctIndex" value="1" /> Falsch</label>
                                }
                                else
                                {
                                    <label><input type="radio" name="correctIndex" value="0" /> Wahr</label>
                                    <label><input type="radio" name="correctIndex" value="1" checked /> Falsch</label>
                                }
                            </div>
                        </div>
                        <label>Zeitlimit (Sekunden)
                            <input name="timeLimitSeconds" type="number" min="5" max="120" value="@q.TimeLimitSeconds" />
                        </label>
                        <label>Erklärung (optional)
                            <textarea name="explanation" rows="2" maxlength="2000" placeholder="Wird nach der Auflösung gezeigt (im Prüfungsmodus erst in der Abschluss-Review)">@q.Explanation</textarea>
                        </label>
                        <label>Tags (optional, kommagetrennt)
                            <input name="tags" maxlength="400" placeholder="z. B. sql, join, netzwerk" value="@tagsDisplay" />
                        </label>
                        <label>IHK-Gewicht (optional, 0 = gleichmäßig)
                            <input name="points" type="number" min="0" max="100" value="@q.Points" />
                        </label>
                        <button type="submit">Änderungen speichern</button>
                        <a class="secondary" href="/Editor/Edit/@quiz.Id">Abbrechen</a>
                    </form>
                }
                else
                {
                    <div class="q-card-head">
                        <span class="q-card-num">@(q.SortOrder + 1).</span>
                        <textarea id="q-preview-src-@q.Id" class="js-q-source" hidden readonly>@q.Text</textarea>
                        <div class="q-text q-card-preview" data-q-preview-for="q-preview-src-@q.Id"></div>
                    </div>
                    @if (q.DisplayKind == QuestionDisplayKind.TrueFalse)
                    {
                        <span class="badge-tf">Wahr/Falsch</span>
                    }
                    @if (!string.IsNullOrEmpty(q.ImagePath))
                    {
                        <img class="q-thumb" src="@q.ImagePath" alt="" />
                    }
                    <ol>
                        @for (var i = 0; i < filled.Count; i++)
                        {
                            <li class="@(q.CorrectIndex == i ? "reveal" : null)">@filled[i]</li>
                        }
                    </ol>
                    @if (qTags.Count > 0)
                    {
                        <div class="tag-row">
                            @foreach (var tag in qTags)
                            {
                                <span class="tag-chip">@tag</span>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(q.Explanation))
                    {
                        <p class="explanation"><strong>Erklärung:</strong> @q.Explanation</p>
                    }
                    <p class="muted">Zeit: @q.TimeLimitSeconds s@(q.Points > 0 ? $" · IHK-Gewicht: {q.Points}" : "")</p>
                    <a class="secondary" asp-page="/Editor/Edit" asp-route-id="@quiz.Id" asp-route-edit="@q.Id">Bearbeiten</a>
                    <form method="post" asp-page-handler="DeleteQuestion">
                        <input type="hidden" name="id" value="@quiz.Id" />
                        <input type="hidden" name="questionId" value="@q.Id" />
                        <button type="submit" class="danger">Frage löschen</button>
                    </form>
                }
            </div>
        }
        </div>
    </section>

    <section class="panel">
        <h2>Frage hinzufügen</h2>
        <form method="post" asp-page-handler="AddQuestion" enctype="multipart/form-data" id="add-question-form">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label class="question-text-field">Fragetext
                <div class="question-compose">
                    <textarea name="text" class="js-question-text-input" required rows="4"></textarea>
                    <div class="question-preview-panel">
                        <p class="question-preview-label muted">Vorschau (wie Teilnehmer)</p>
                        <div class="q-text js-question-preview" aria-live="polite"></div>
                    </div>
                </div>
            </label>
            <label>Fragetyp
                <select name="displayKind" id="displayKind">
                    <option value="Mc">Multiple Choice</option>
                    <option value="TrueFalse">Wahr/Falsch</option>
                </select>
            </label>
            <label>Bild (optional, max. 2&nbsp;MB — JPEG/PNG/WebP/GIF)
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
            </label>
            <div id="mc-options" class="js-mc-options">
                <label>Option A<input class="mc-option" name="option0" data-required-mc="true" required /></label>
                <label>Option B<input class="mc-option" name="option1" data-required-mc="true" required /></label>
                <label>Option C<input class="mc-option" name="option2" /></label>
                <label>Option D<input class="mc-option" name="option3" /></label>
                <label>Option E<input class="mc-option" name="option4" /></label>
                <label>Option F<input class="mc-option" name="option5" /></label>
                <label>Richtige Antwort
                    <select name="correctIndex" id="correctIndexSelect" class="js-correct-select">
                        <option value="0">A</option>
                        <option value="1">B</option>
                        <option value="2">C</option>
                        <option value="3">D</option>
                    </select>
                </label>
            </div>
            <div id="tf-options" class="js-tf-options" hidden>
                <p class="muted">Antworten: Wahr und Falsch (fest)</p>
                <div class="tf-row">
                    <label><input type="radio" name="correctIndex" value="0" checked /> Wahr</label>
                    <label><input type="radio" name="correctIndex" value="1" /> Falsch</label>
                </div>
            </div>
            <label>Zeitlimit (Sekunden)
                <input name="timeLimitSeconds" type="number" min="5" max="120" value="20" />
            </label>
            <label>Erklärung (optional)
                <textarea name="explanation" rows="2" maxlength="2000" placeholder="Wird nach der Auflösung gezeigt (im Prüfungsmodus erst in der Abschluss-Review)"></textarea>
            </label>
            <label>Tags (optional, kommagetrennt)
                <input name="tags" maxlength="400" placeholder="z. B. sql, join, netzwerk" />
            </label>
            <label>IHK-Gewicht (optional, 0 = gleichmäßig)
                <input name="points" type="number" min="0" max="100" value="0" />
            </label>
            <button type="submit">Frage speichern</button>
        </form>
    </section>

    <p class="app-version" aria-label="App-Version">v@(AppVersion.Display)</p>
</main>
<script>
(function () {
  const labels = ['A', 'B', 'C', 'D', 'E', 'F'];

  function wireQuestionForm(root) {
    const kindSelect = root.querySelector('select[name="displayKind"]');
    const mcBlock = root.querySelector('.js-mc-options');
    const tfBlock = root.querySelector('.js-tf-options');
    const correctSelect = root.querySelector('.js-correct-select');
    if (!kindSelect || !mcBlock || !tfBlock) {
      return;
    }

    function mcInputs() {
      return Array.from(mcBlock.querySelectorAll('.mc-option'));
    }

    function filledMcCount() {
      const inputs = mcInputs();
      let count = 0;
      for (const inp of inputs) {
        if (!inp.value.trim()) break;
        count++;
      }
      return count;
    }

    function refreshCorrectSelect() {
      if (!correctSelect) {
        return;
      }
      const count = Math.max(2, filledMcCount());
      const prev = correctSelect.value;
      correctSelect.innerHTML = '';
      for (let i = 0; i < count && i < labels.length; i++) {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = labels[i];
        correctSelect.appendChild(opt);
      }
      if (prev && correctSelect.querySelector('option[value="' + prev + '"]')) {
        correctSelect.value = prev;
      }
    }

    function setMode() {
      const tf = kindSelect.value === 'TrueFalse';
      mcBlock.hidden = tf;
      tfBlock.hidden = !tf;
      mcInputs().forEach(function (inp) {
        inp.disabled = tf;
        inp.required = !tf && inp.dataset.requiredMc === 'true';
      });
      if (correctSelect) {
        correctSelect.disabled = tf;
      }
      tfBlock.querySelectorAll('input[type="radio"]').forEach(function (r) {
        r.disabled = !tf;
      });
    }

    kindSelect.addEventListener('change', setMode);
    mcInputs().forEach(function (inp) {
      inp.addEventListener('input', refreshCorrectSelect);
    });
    setMode();
    refreshCorrectSelect();
  }

  const addForm = document.getElementById('add-question-form');
  if (addForm) {
    wireQuestionForm(addForm);
  }
  document.querySelectorAll('[data-edit-form]').forEach(function (form) {
    wireQuestionForm(form);
  });
})();
</script>
    <script src="/lib/prism/prism.min.js"></script>
    <script src="/lib/prism/prism-csharp.min.js"></script>
    <script src="/js/question-format.js"></script>
    <script src="/js/editor-preview.js"></script>
</body>
</html>
