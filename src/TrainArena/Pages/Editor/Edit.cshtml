@page "{id:guid}"
@model TrainArena.Pages.Editor.EditModel
@{
    Layout = null;
    var quiz = Model.Quiz!;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/brand/favicon.png?v=20261008" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/brand/logo-icon.png?v=20261008" />
    <title>Quiz bearbeiten — @quiz.Title</title>
    <link rel="stylesheet" href="/css/host.css" />
    <style>
      label { display: block; margin: 0.5rem 0; color: var(--muted); }
      input, select, textarea {
        display: block; width: 100%; margin-top: 0.25rem;
        padding: 0.55rem 0.65rem; border-radius: 8px; border: 1px solid #475569;
        background: #0f172a; color: var(--text);
      }
      input[type="file"] { padding: 0.35rem 0; border: 0; background: transparent; }
      .error { color: #f87171; }
      .info { color: var(--ok); }
      .q-card { border-top: 1px solid #334155; padding-top: 0.75rem; margin-top: 0.75rem; }
      .q-thumb { max-width: 12rem; max-height: 8rem; margin: 0.5rem 0; border-radius: 8px; display: block; }
    </style>
</head>
<body>
<main class="host">
    <div class="brand-row">
        <img class="brand-mark" src="/assets/brand/logo-icon.png?v=20261008" width="64" height="64" alt="TrainArena" />
        <h1>Quiz bearbeiten</h1>
    </div>
    <p class="tagline"><a href="/Editor">← Alle Quizzes</a> · <a href="/">Host</a></p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="error">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <p class="info">@Model.InfoMessage</p>
    }

    <section class="panel">
        <form method="post" asp-page-handler="SaveTitle">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Titel
                <input name="title" value="@quiz.Title" required maxlength="200" />
            </label>
            <button type="submit">Titel speichern</button>
        </form>
    </section>

    <section class="panel">
        <h2>Import CSV / Kahoot</h2>
        <p class="muted">TrainArena-CSV oder Kahoot-ähnliche Tabelle (als CSV). Ungültige Zeilen werden übersprungen.</p>
        <form method="post" asp-page-handler="Import" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Datei
                <input type="file" name="file" accept=".csv,text/csv" required />
            </label>
            <button type="submit">Importieren</button>
        </form>
    </section>

    <section class="panel">
        <h2>Fragen (@quiz.Questions.Count)</h2>
        @foreach (var q in quiz.Questions.OrderBy(x => x.SortOrder))
        {
            <div class="q-card">
                <strong>@(q.SortOrder + 1). @q.Text</strong>
                @if (!string.IsNullOrEmpty(q.ImagePath))
                {
                    <img class="q-thumb" src="@q.ImagePath" alt="" />
                }
                <ol>
                    <li class="@(q.CorrectIndex == 0 ? "reveal" : null)">@q.Option0</li>
                    <li class="@(q.CorrectIndex == 1 ? "reveal" : null)">@q.Option1</li>
                    <li class="@(q.CorrectIndex == 2 ? "reveal" : null)">@q.Option2</li>
                    <li class="@(q.CorrectIndex == 3 ? "reveal" : null)">@q.Option3</li>
                </ol>
                <p class="muted">Zeit: @q.TimeLimitSeconds s</p>
                <form method="post" asp-page-handler="DeleteQuestion">
                    <input type="hidden" name="id" value="@quiz.Id" />
                    <input type="hidden" name="questionId" value="@q.Id" />
                    <button type="submit">Frage löschen</button>
                </form>
            </div>
        }
    </section>

    <section class="panel">
        <h2>Frage hinzufügen</h2>
        <form method="post" asp-page-handler="AddQuestion" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Fragetext<textarea name="text" required rows="2"></textarea></label>
            <label>Bild (optional, max. 2&nbsp;MB — JPEG/PNG/WebP/GIF)
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
            </label>
            <label>Option A<input name="option0" required /></label>
            <label>Option B<input name="option1" required /></label>
            <label>Option C<input name="option2" required /></label>
            <label>Option D<input name="option3" required /></label>
            <label>Richtige Antwort
                <select name="correctIndex">
                    <option value="0">A</option>
                    <option value="1">B</option>
                    <option value="2">C</option>
                    <option value="3">D</option>
                </select>
            </label>
            <label>Zeitlimit (Sekunden)
                <input name="timeLimitSeconds" type="number" min="5" max="120" value="20" />
            </label>
            <button type="submit">Frage speichern</button>
        </form>
    </section>
</main>
</body>
</html>
