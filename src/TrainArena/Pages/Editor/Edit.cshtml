@page "{id:guid}"
@using TrainArena.Data
@using TrainArena.Data.Entities
@model TrainArena.Pages.Editor.EditModel
@{
    Layout = null;
    var quiz = Model.Quiz!;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/brand/favicon.png?v=20261008" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/brand/logo-icon.png?v=20261008" />
    <title>Quiz bearbeiten — @quiz.Title</title>
    <link rel="stylesheet" href="/css/host.css" />
</head>
<body>
<main class="host editor">
    <div class="brand-row">
        <img class="brand-mark" src="/assets/brand/logo-icon.png?v=20261008" width="64" height="64" alt="TrainArena" />
        <h1>Quiz bearbeiten</h1>
    </div>
    <p class="tagline"><a href="/Editor">← Alle Quizzes</a> · <a href="/">Host</a></p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="flash flash-error" role="alert">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <p class="flash flash-ok" role="status">@Model.InfoMessage</p>
    }

    <section class="panel">
        <form method="post" asp-page-handler="SaveTitle">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Titel
                <input name="title" value="@quiz.Title" required maxlength="200" />
            </label>
            <button type="submit">Titel speichern</button>
        </form>
    </section>

    <section class="panel">
        <h2>Import CSV / JSON</h2>
        <p class="muted">TrainArena-CSV, Kahoot-CSV oder JSON-Quiz-Pack. Ungültige Einträge werden übersprungen. JSON kann Fragetypen, Code-Fences und eingebettete Bilder (Base64) enthalten — siehe <code>docs/quizzes/</code>.</p>
        <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="import-zone">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Datei wählen
                <input type="file" name="file" accept=".csv,.json,text/csv,application/json" required />
            </label>
            <button type="submit">Importieren</button>
        </form>
    </section>

    <section class="panel">
        <h2>Fragen (@quiz.Questions.Count)</h2>
        @if (quiz.Questions.Count == 0)
        {
            <p class="muted editor-empty">Noch keine Fragen — Import nutzen oder unten anlegen.</p>
        }
        @foreach (var q in quiz.Questions.OrderBy(x => x.SortOrder))
        {
            var filled = QuizRules.GetFilledOptions(q);
            <div class="q-card">
                <strong>@(q.SortOrder + 1). @q.Text</strong>
                @if (q.DisplayKind == QuestionDisplayKind.TrueFalse)
                {
                    <span class="badge-tf">Wahr/Falsch</span>
                }
                @if (!string.IsNullOrEmpty(q.ImagePath))
                {
                    <img class="q-thumb" src="@q.ImagePath" alt="" />
                }
                <ol>
                    @for (var i = 0; i < filled.Count; i++)
                    {
                        <li class="@(q.CorrectIndex == i ? "reveal" : null)">@filled[i]</li>
                    }
                </ol>
                @{
                    var qTags = QuestionTags.Parse(q.Tags);
                }
                @if (qTags.Count > 0)
                {
                    <div class="tag-row">
                        @foreach (var tag in qTags)
                        {
                            <span class="tag-chip">@tag</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(q.Explanation))
                {
                    <p class="explanation"><strong>Erklärung:</strong> @q.Explanation</p>
                }
                <p class="muted">Zeit: @q.TimeLimitSeconds s@(q.Points > 0 ? $" · IHK-Gewicht: {q.Points}" : "")</p>
                <form method="post" asp-page-handler="DeleteQuestion">
                    <input type="hidden" name="id" value="@quiz.Id" />
                    <input type="hidden" name="questionId" value="@q.Id" />
                    <button type="submit" class="danger">Frage löschen</button>
                </form>
            </div>
        }
    </section>

    <section class="panel">
        <h2>Frage hinzufügen</h2>
        <form method="post" asp-page-handler="AddQuestion" enctype="multipart/form-data" id="add-question-form">
            <input type="hidden" name="id" value="@quiz.Id" />
            <label>Fragetext<textarea name="text" required rows="2"></textarea></label>
            <label>Fragetyp
                <select name="displayKind" id="displayKind">
                    <option value="Mc">Multiple Choice</option>
                    <option value="TrueFalse">Wahr/Falsch</option>
                </select>
            </label>
            <label>Bild (optional, max. 2&nbsp;MB — JPEG/PNG/WebP/GIF)
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
            </label>
            <div id="mc-options">
                <label>Option A<input class="mc-option" name="option0" data-required-mc="true" required /></label>
                <label>Option B<input class="mc-option" name="option1" data-required-mc="true" required /></label>
                <label>Option C<input class="mc-option" name="option2" /></label>
                <label>Option D<input class="mc-option" name="option3" /></label>
                <label>Option E<input class="mc-option" name="option4" /></label>
                <label>Option F<input class="mc-option" name="option5" /></label>
                <label>Richtige Antwort
                    <select name="correctIndex" id="correctIndexSelect">
                        <option value="0">A</option>
                        <option value="1">B</option>
                        <option value="2">C</option>
                        <option value="3">D</option>
                    </select>
                </label>
            </div>
            <div id="tf-options" hidden>
                <p class="muted">Antworten: Wahr und Falsch (fest)</p>
                <div class="tf-row">
                    <label><input type="radio" name="correctIndex" value="0" checked /> Wahr</label>
                    <label><input type="radio" name="correctIndex" value="1" /> Falsch</label>
                </div>
            </div>
            <label>Zeitlimit (Sekunden)
                <input name="timeLimitSeconds" type="number" min="5" max="120" value="20" />
            </label>
            <label>Erklärung (optional)
                <textarea name="explanation" rows="2" maxlength="2000" placeholder="Wird nach der Auflösung gezeigt (im Prüfungsmodus erst in der Abschluss-Review)"></textarea>
            </label>
            <label>Tags (optional, kommagetrennt)
                <input name="tags" maxlength="400" placeholder="z. B. sql, join, netzwerk" />
            </label>
            <label>IHK-Gewicht (optional, 0 = gleichmäßig)
                <input name="points" type="number" min="0" max="100" value="0" />
            </label>
            <button type="submit">Frage speichern</button>
        </form>
    </section>

    <p class="app-version" aria-label="App-Version">v@(AppVersion.Display)</p>
</main>
<script>
(function () {
  const kindSelect = document.getElementById('displayKind');
  const mcBlock = document.getElementById('mc-options');
  const tfBlock = document.getElementById('tf-options');
  const correctSelect = document.getElementById('correctIndexSelect');
  const labels = ['A', 'B', 'C', 'D', 'E', 'F'];

  function mcInputs() {
    return Array.from(document.querySelectorAll('.mc-option'));
  }

  function filledMcCount() {
    const inputs = mcInputs();
    let count = 0;
    for (const inp of inputs) {
      if (!inp.value.trim()) break;
      count++;
    }
    return count;
  }

  function refreshCorrectSelect() {
    const count = Math.max(2, filledMcCount());
    const prev = correctSelect.value;
    correctSelect.innerHTML = '';
    for (let i = 0; i < count && i < labels.length; i++) {
      const opt = document.createElement('option');
      opt.value = String(i);
      opt.textContent = labels[i];
      correctSelect.appendChild(opt);
    }
    if (prev && correctSelect.querySelector('option[value="' + prev + '"]')) {
      correctSelect.value = prev;
    }
  }

  function setMode() {
    const tf = kindSelect.value === 'TrueFalse';
    mcBlock.hidden = tf;
    tfBlock.hidden = !tf;
    mcInputs().forEach(function (inp) {
      inp.disabled = tf;
      inp.required = !tf && inp.dataset.requiredMc === 'true';
    });
    correctSelect.disabled = tf;
    tfBlock.querySelectorAll('input[type="radio"]').forEach(function (r) {
      r.disabled = !tf;
    });
  }

  kindSelect.addEventListener('change', setMode);
  mcInputs().forEach(function (inp) {
    inp.addEventListener('input', refreshCorrectSelect);
  });
  setMode();
  refreshCorrectSelect();
})();
</script>
</body>
</html>
